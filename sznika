using System;
using System.Collections.Generic;
using System.Runtime.CompilerServices;
using System.Security.Cryptography.X509Certificates;
using System.Text;
using System.Xml.Serialization;

namespace Lab2
{
    public delegate void AgeChangingDelegate(int oldAge, int newAge);   // ez nem metodus definicio, nem kell torzs neki   
    [XmlRoot("Szemely")]
    public class Person
    {
        private int age;
        [XmlAttribute("Kor")]
        public int Age
        {
            get { return age; }
            set {
                if (value < 0)
                {
                    throw new ArgumentOutOfRangeException("Invalid age");
                }
                if (AgeChanging != null)
                {
                    AgeChanging(age, value);
                }
                // AgeChanging?.Invoke(age, value) ez, es a folotte levo ekvivalens
                age = value;
            }
        }
        /*
        public string Name // ez és az alatta levő megoldás ekvivalens
        {
          get { return field; }
          set { field = value}
        }
        */
        //public AgeChangingDelegate AgeChanging;
        [XmlIgnore] // nem kerul mentesre
        public required string Name  // auto-implementalt megvalositas
                                     // a tulajdonság értékét mindenképpen meg kell adni az objektuminicializáló szintaxisban, különben fordítási hibát kapunk.
        {
            get; set;
        } = "Ismeretlen"; // default érték
        // lehet set helyett init, ekkor nem lehet explicit értéket adni, csak inicializáláskor ( p.Name = "Gábor" -> nem mukodik)
        public event AgeChangingDelegate AgeChanging;
        public int AgeInDogYear { get { return age * 7; } } // read-only 

    }
}
