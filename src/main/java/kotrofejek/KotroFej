package kotrofejek;

/**
 * A hókotrókra szerelhető fejek absztrakt ősosztálya.
 * Meghatározza a tisztítási mechanizmust és az eszköz értékét.
 */
public abstract class KotroFej {
    
    /** A kotrófej egységára. */
    protected int ar;

    /**
     * Elvégzi az úttest tisztítását.
     * @param cel A célzott forgalmi sáv.
     * @param melle A szomszédos sáv, ahová a havat kotorhatja.
     * @param ut Az érintett útszakasz.
     */
    public abstract void tisztit(Object cel, Object melle, Object ut);

    /**
     * Visszaadja a kotrófej típusának megnevezését.
     * @return Az eszköz neve.
     */
    public abstract String getNev();

    /**
     * Lekérdezi az eszköz árát.
     * @return Az ár egész értéke.
     */
    public int getAr() {
        return ar;
    }

    /**
     * Visszaadja a konkrét kotrófej példányt.
     * @return Az aktuális KotroFej objektum.
     */
    public KotroFej getKotroFej() {
        return this;
    }
}