<Init>
    <Jatekallapot korok="1" />
    
    <Terkep>
        <Ut tipus="sima" nev="S1" hossz="5" pozsav="3" negsav="1">
            <Elagazodas>
                <Szomszed nev="H1" irany="1" />
                <Szomszed nev="A1" irany="1" />
            </Elagazodas>
        </Ut>
        <Ut tipus="hid" nev="H1" hossz="2" pozsav="1" negsav="1">
            <Elagazodas>
                <Szomszed nev="S1" irany="-1" />
            </Elagazodas>
        </Ut>
        <Ut tipus="alagut" nev="A1" hossz="2" pozsav="1" negsav="1"> 
            <Elagazodas>
                <Szomszed nev="S1" irany="-1" />
            </Elagazodas>
        </Ut>
    </Terkep>
    '' alapbol minden utszakasz 0 0 0 0
    <Utviszonyok>
        '' S1
        <Sav>
            <Lokacio ut="S1" szakasz="4" sav="1" />
            <Allapot athaladokszama="5" ho="30" so="0" zuzalek="0" />
        </Sav>
        <Sav>
            <Lokacio ut="S1" szakasz="4" sav="2" />
            <Allapot athaladokszama="2" ho="100" so="0" zuzalek="0" />
        </Sav>
        <Sav>
            <Lokacio ut="S1" szakasz="4" sav="3" />
            <Allapot athaladokszama="2" ho="100" so="0" zuzalek="0" />
        </Sav>
        '' H1
        <Sav>
            <Lokacio ut="H1" szakasz="2" sav="1" />
            <Allapot athaladokszama="0" ho="25" so="0" zuzalek="0" />
        </Sav>
    </Utviszonyok>
    
    <Jarmuvek>
        <Hokotrok>
            <Hokotro nev="H1">
                <Lokacio ut="S1" szakasz="3" sav="3" />
                <Eszkoztar>
                    '' 0=nincs ilyen 1=van ilyen 2=felszerelt
                    <Kotrofejek sopro="2" hanyo="0" sarkany="0" jegtoro="0" soszoro="0" zuzott="0" />
                    <Fogyoanyagok so="0" biokerozin="0" zuzalek="0" />
                </Eszkoztar>
             </Hokotro> 
                <Hokotro nev="H2">
                     <Lokacio ut="S1" szakasz="4" sav="-1" />
                     <Eszkoztar>
                    '' 0=nincs ilyen 1=van ilyen 2=felszerelt
                          <Kotrofejek sopro="2" hanyo="0" sarkany="0" jegtoro="0" soszoro="0" zuzott="0" />
                    <Fogyoanyagok so="0" biokerozin="0" zuzalek="0" />
                </Eszkoztar>
             </Hokotro> 
        </Hokotrok>
        
        <Buszok>
            <Busz nev="B1" mozgaskeptelen="0">
                <Lokacio ut="S1" szakasz="2" sav="2" />
                <Vegallomas ut="S1" szakasz="5" sav="3" />
            </Busz>
            
            <Busz nev="B2" mozgaskeptelen="0">
                <Lokacio ut="H1" szakasz="1" sav="1" />
                <Cel ut="H1" szakasz="2" sav="1" />
            </Busz>
        </Buszok>
        <Autok>
            <Auto id="A1" mozgaskeptelen="0">
                <Lokacio ut="S1" szakasz="1" sav="1" />
                <Lakas ut="S1" szakasz="1" sav="1" />
                <Munkahely ut="S1" szakasz="5" sav="3" />
            </Auto>
            
            <Auto id="A2" mozgaskeptelen="0">
                <Lokacio ut="A1" szakasz="2" sav="-1" />
                <Lakas ut="A1" szakasz="2" sav="-1" />
                <Munkahely ut="A1" szakasz="1" sav="-1" />
            </Auto>
        </Autok>
    </Jarmuvek>
    <Jatekosok>
        <Takaritok>
            <Takarito id="T1" akcio="3" penz="100"  valasztott="H1">
                <Hokotro id="H1" />
                <Hokotro id="H2" />
            </Takarito>
        </Takaritok>
        
        <Buszvezetok>
            <Buszvezeto id="B1" akcio="3" pont="0"  valasztott="B1">
                <Busz id="B1" />
                <Busz id="B2" />
            </Buszvezeto>
        </Buszvezetok>
    </Jatekosok>
    <SoronLevoJatekos id="H1" />
</Init>